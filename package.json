{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "check:secrets": "tsx scripts/check-workflow-secrets.ts",
    "n8n:up": "docker compose up -d",
    "n8n:import": "docker compose exec n8n sh -c \"n8n import:credentials --input=/lendloop/credentials/mailhog-smtp.json && n8n import:workflow --separate --input=/lendloop/workflows && for id in LLerrorHandler01 LLrequestNotify1 LLoverdueRemind1; do n8n publish:workflow --id=$id; done\"",
    "n8n:run-overdue": "docker compose exec -e N8N_RUNNERS_BROKER_PORT=5690 n8n n8n execute --id=LLoverdueRemind1",
    "n8n:export": "tsx scripts/export-n8n-workflows.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.3",
    "convex": "^1.51.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.72",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.18.0"
}
