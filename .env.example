# ─────────────────────────────────────────────────────────────────────────────
# LendLoop environment variables. Copy to .env.local (Next.js) and set the
# Convex ones with `npx convex env set NAME value`. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js (.env.local) ─────────────────────────────────────────────────────
# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk → Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Convex deployment env (npx convex env set ...) ───────────────────────────
# Clerk Frontend API URL (Clerk → Integrations → Convex), e.g. https://xyz.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=
# Comma-separated emails auto-promoted to admin on sign-in (verified emails only).
# ADMIN_EMAILS=you@example.com
# n8n Workflow A webhook URL as reachable FROM Convex.
#   Local Convex backend → http://localhost:5678/webhook/lendloop-loan-events
#   Cloud Convex → a public tunnel URL (see README)
# N8N_WEBHOOK_URL=
# Shared HMAC secret, at least 32 random bytes: `openssl rand -hex 32`.
# Must be identical in Convex and n8n.
# N8N_WEBHOOK_SECRET=

# ── n8n (docker-compose reads ./.env or your shell) ──────────────────────────
# Same value as the Convex N8N_WEBHOOK_SECRET.
N8N_WEBHOOK_SECRET=
# Convex HTTP actions base URL as reachable FROM the n8n container.
#   Local Convex backend → http://host.docker.internal:3211
#   Cloud Convex → https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
# "smtp" sends real email via the n8n SMTP credential (MailHog locally); "log" only logs.
NOTIFY_MODE=smtp
NOTIFY_FROM=LendLoop <no-reply@lendloop.local>
# Encrypts credentials stored in n8n's database: `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=
